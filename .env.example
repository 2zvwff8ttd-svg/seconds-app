# Copy to .env.local and fill in from Supabase Dashboard → Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Auth CAPTCHA (Cloudflare Turnstile) ---
# Site key only in the app. Secret key → Supabase Dashboard → Authentication →
# Bot and Abuse Protection (enable AFTER the app ships this code).
# Leave unset to skip the widget (auth works; enable Supabase CAPTCHA only after Site key is set).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Required once to apply DB migration (npm run db:apply-status)
# Dashboard → Settings → Database → Database password
# SUPABASE_DB_PASSWORD=your-database-password
#
# npm run db:apply-fixes   — DBマイグレーション一括適用
# npm run db:enable-realtime — Realtime（likes/comments）有効化
# supabase/sql/010-music-storage.sql — プリセットBGM用 music バケット

# --- AI（投稿画面）---
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.5-flash
# AI_MUSIC_PROVIDER=replicate
# REPLICATE_API_TOKEN=your-replicate-token
# SUNO_API_KEY=your-suno-key
# SUNO_API_BASE=https://api.sunoapi.org/api/v1

# --- AI（プロフィール証明写真風）---
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_PROFILE_PHOTO_MODEL=gpt-image-1.5
# AI_PROFILE_PHOTO_DAILY_LIMIT=3
# supabase/sql/033-ai-profile-photo-jobs.sql — 日次上限・ジョブ記録

# --- 開発中機能（外部テストには出さない）---
# NEXT_PUBLIC_NARRATION_MERGE_ENABLED=1
