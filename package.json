{
  "name": "next-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "node scripts/copy-ffmpeg-core.mjs && node scripts/patch-camera-preview-android.mjs && node scripts/patch-camera-preview-ios.mjs && node scripts/verify-camera-preview-ios-patch.mjs",
    "build": "node scripts/copy-ffmpeg-core.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "db:apply-status": "node scripts/apply-video-status.mjs",
    "db:apply-fixes": "node scripts/apply-db-fixes.mjs",
    "db:apply-handle-new-user": "node scripts/apply-handle-new-user-fix.mjs",
    "db:enable-realtime": "node scripts/enable-realtime.mjs",
    "functions:deploy-daily-morning": "npx --yes supabase functions deploy daily-morning --no-verify-jwt",
    "functions:deploy-delete-account": "npx --yes supabase functions deploy delete-account",
    "functions:invoke-daily-morning": "node scripts/invoke-daily-morning.mjs",
    "icons:generate": "node scripts/generate-pwa-icons.mjs",
    "cap:sync": "npx cap sync android && node scripts/fix-android-strings.mjs && node scripts/patch-camera-preview-android.mjs",
    "cap:clean": "node scripts/clean-android-build.mjs",
    "cap:open": "npx cap open android",
    "cap:run": "npx cap run android"
  },
  "dependencies": {
    "@capacitor-community/camera-preview": "^8.0.1",
    "@capacitor/android": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.4.0",
    "@ffmpeg/core": "^0.12.9",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@google/generative-ai": "^0.24.1",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16.5.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "postgres": "^3.4.7",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "@emnapi/core": "1.11.0",
    "@emnapi/runtime": "1.11.0"
  },
  "optionalDependencies": {
    "@emnapi/core": "1.11.0",
    "@emnapi/runtime": "1.11.0"
  }
}
